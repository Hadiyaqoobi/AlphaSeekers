generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserLanguage {
  FA
  EN
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

// How a class's sessions get their date/time.
//  AUTO   = availability/preference-driven auto-scheduler (default; unchanged).
//  MANUAL = the instructor sets/confirms exact session times themselves; the
//           auto-scheduler skips these classes.
enum SchedulingMode {
  AUTO
  MANUAL
}

enum MeetLinkStatus {
  GENERATED
  PENDING
  FAILED
}

enum OpportunityType {
  SCHOLARSHIP
  JOB
  INTERNSHIP
  GRANT
}

enum NotificationChannel {
  WHATSAPP
  TELEGRAM
  WEB_PUSH
  EMAIL
  PLATFORM
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
}

enum SchedulerJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String                @unique
  phone                 String?
  passwordHash          String?
  role                  UserRole
  // Staff access tier layered ON TOP of role. Only meaningful for role=ADMIN.
  // Values: SUPER_ADMIN, ADMIN, CONTENT_MANAGER, FINANCE, MODERATOR, SUPPORT.
  // Null on a legacy ADMIN = unrestricted full admin (backward compatible).
  accessLevel           String?
  // Granular per-module permission grants, e.g. ["users.view","classes.edit"].
  // Null on a legacy ADMIN = unrestricted. See src/lib/security/permissions.ts.
  permissions           Json?
  // Employee lifecycle: set to deactivate an employee immediately (checked live).
  deactivatedAt         DateTime?
  // Force a password reset on next login (temp-password onboarding flow).
  mustChangePassword    Boolean               @default(false)
  passwordResets        PasswordReset[]
  // Which super-admin created this employee account (audit trail).
  createdById           String?
  timezone              String                @default("Asia/Kabul")
  language              UserLanguage          @default(FA)
  approvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  teachingClasses       Class[]               @relation("ClassTeacher")
  enrollments           Enrollment[]
  attendance            Attendance[]
  availabilitySlots     TeacherAvailability[]
  uploadedMaterials     Material[]            @relation("MaterialUploader")
  notifications         Notification[]
  webinarRegistrations  WebinarRegistration[]
  aiInteractions        AIInteraction[]
  posts                 StudentPost[]
  learningPaths         LearningPath[]
  googleAccountLink     GoogleAccountLink?
  telegramChatId        String?
  pushSubscription      String?
  notificationPrefs     String?               // JSON: { telegram: bool, webPush: bool, email: bool }

  // Role-filtered lists/counts (teachers, students) and approval-queue filters
  // scan large user tables; index the discriminators.
  @@index([role])
  @@index([approvedAt])
  // Staff/employee listings filter by role=ADMIN + accessLevel present.
  @@index([accessLevel])
}

model Class {
  id                    String                @id @default(cuid())
  name                  String
  subjectCategory       String
  description           String
  teacherId             String
  maxStudents           Int
  durationMinutes       Int                   @default(60)
  schedulePreference    String?
  language              String                @default("Dari")
  registrationFormUrl   String?
  whatsappGroupUrl      String?
  published             Boolean               @default(true)
  status                ClassStatus           @default(ACTIVE)
  schedulingMode        SchedulingMode        @default(AUTO)
  termId                String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  teacher               User                  @relation("ClassTeacher", fields: [teacherId], references: [id])
  sessions              Session[]
  enrollments           Enrollment[]
  materials             Material[]
  documentChunks        DocumentChunk[]
  announcements         ClassAnnouncement[]
}

model Session {
  id                    String                @id @default(cuid())
  classId               String
  startTime             DateTime
  endTime               DateTime
  meetLink              String?
  meetLinkStatus        MeetLinkStatus        @default(PENDING)
  // The Google Calendar event backing this session's Meet link, so a reschedule
  // can PATCH the same event (preserving the link) and a cancel can delete it —
  // instead of orphaning events + leaving old Meet links joinable.
  googleEventId         String?
  googleCalendarId      String?
  cancelled             Boolean               @default(false)
  // Set when the instructor explicitly set/confirmed this session's time.
  // null on an auto-proposed session awaiting confirmation.
  confirmedAt           DateTime?
  createdAt             DateTime              @default(now())

  // Attendance check-in: teacher generates a 4-digit code during class;
  // students enter it to verify they were actually present.
  checkinCode           String?
  checkinCodeExpiresAt  DateTime?

  class                 Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance            Attendance[]
  materials             Material[]
  summary               SessionSummary?
  notes                 SessionNote[]
  homeworkAssignments   HomeworkAssignment[]

  // Hot paths: filter by class (schedule/join-now), by time window (reminder/today
  // batches), and by both together (per-class upcoming lookups).
  @@index([classId])
  @@index([startTime])
  @@index([classId, startTime])
}

model Enrollment {
  id                    String                @id @default(cuid())
  studentId             String
  classId               String
  enrolledAt            DateTime              @default(now())
  status                EnrollmentStatus      @default(ACTIVE)

  student               User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class                 Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  // Roster/count queries filter by classId first; the unique above is studentId-first
  // and does not serve these, so add an explicit classId index.
  @@index([classId])
}

model Attendance {
  id                    String                @id @default(cuid())
  sessionId             String
  studentId             String
  attended              Boolean               @default(false)
  joinedAt              DateTime?

  // Second-layer verification: did the student enter the check-in code?
  checkinVerified       Boolean               @default(false)
  checkinAt             DateTime?

  session               Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student               User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  // sessionId-first lookups (session attendance) are already served by the
  // composite unique above. Student-centric aggregates (attendance history) need
  // a studentId-first index.
  @@index([studentId])
}

model TeacherAvailability {
  id                    String                @id @default(cuid())
  teacherId             String
  dayOfWeek             Int
  startTimeUTC          DateTime
  endTimeUTC            DateTime

  teacher               User                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, dayOfWeek])
}

model Material {
  id                    String                @id @default(cuid())
  classId               String
  title                 String
  fileUrl               String
  fileSize              Int
  uploadedBy            String
  sessionId             String?
  createdAt             DateTime              @default(now())

  class                 Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  uploader              User                  @relation("MaterialUploader", fields: [uploadedBy], references: [id])
  session               Session?              @relation(fields: [sessionId], references: [id], onDelete: SetNull)
}

model Opportunity {
  id                    String                @id @default(cuid())
  title                 String
  type                  OpportunityType
  description           String
  deadline              DateTime
  externalUrl           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model LibraryResource {
  id                    String                @id @default(cuid())
  title                 String
  author                String?
  category              String
  fileUrl               String?
  externalUrl           String?
  fileSize              Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model Webinar {
  id                    String                @id @default(cuid())
  title                 String
  description           String
  startsAt              DateTime
  meetLink              String
  language              String                @default("Dari")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  registrations         WebinarRegistration[]
}

model WebinarRegistration {
  id                    String                @id @default(cuid())
  webinarId             String
  userId                String
  registeredAt          DateTime              @default(now())

  webinar               Webinar               @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([webinarId, userId])
}

model Notification {
  id                    String                @id @default(cuid())
  userId                String
  dedupeKey             String?
  channel               NotificationChannel
  content               String
  status                NotificationStatus    @default(PENDING)
  sentAt                DateTime?
  createdAt             DateTime              @default(now())

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  // Per-user notification feed is ordered newest-first; index (userId, createdAt).
  @@index([userId, createdAt])
  @@unique([dedupeKey, channel])
}

model SchedulerJob {
  id                    String                @id @default(cuid())
  status                SchedulerJobStatus    @default(PENDING)
  processedCount        Int                   @default(0)
  totalCount            Int                   @default(0)
  lastRunAt             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model GoogleAccountLink {
  id                    String                @id @default(cuid())
  userId                String                @unique
  googleEmail           String?
  refreshToken          String
  accessToken           String?
  scope                 String?
  expiryDate            DateTime?
  calendarId            String                @default("primary")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── RAG Study Assistant ───

model DocumentChunk {
  id                    String                @id
  sourceType            String                // "LIBRARY" | "MATERIAL"
  sourceId              String
  sourceTitle           String
  content               String
  chunkIndex            Int
  tokenCount            Int                   @default(0)
  classId               String?               // FK to Class — which class does this material belong to?
  // embedding vector(384) — managed via raw SQL, not Prisma
  // See: prisma/migrations/20260413000000_add_rag_vector_store/migration.sql
  createdAt             DateTime              @default(now())

  class                 Class?                @relation(fields: [classId], references: [id])

  @@index([sourceType, sourceId])
  @@index([classId])
}

// ─── AI Response Cache ───

model CachedResponse {
  id            String    @id @default(cuid())
  questionHash  String    @unique
  questionText  String
  questionLang  String    @default("en")
  answer        String    @db.Text
  sources       String?   @db.Text
  provider      String
  quality       Float?
  hitCount      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime?
}

// ─── AI Interaction Tracking ───

model AIInteraction {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String?  // Chat session ID from sessionStorage
  query       String   @db.Text
  answer      String?  @db.Text
  sources     String?  @db.Text  // JSON array of source citations
  mode        String   @default("study") // study, practice, quiz, explain, vocabulary, prepare
  topics      String?  // Comma-separated detected topics
  rating      String?  // positive, negative, null
  provider    String?  // groq, gemma, cache
  classIds    String?  // Comma-separated class IDs searched
  responseMs  Int?     // Time to first byte in ms
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation  AIEvaluation?

  @@index([userId, createdAt])
  @@index([mode, createdAt])
}

// ─── AI Safety & Evaluation ───

model AISafetyLog {
  id                  String    @id @default(cuid())
  interactionId       String?
  confidenceScore     Float
  confidenceLevel     String    // high, medium, low
  safetyPassed        Boolean
  safetyCategory      String?   // harmful, off_topic, inappropriate
  safetyAction        String    // allow, warn, block
  guardrailViolations String?   @db.Text // JSON array of violated principles
  blockedResponse     String?   @db.Text // The response that was blocked
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNotes         String?   @db.Text
  createdAt           DateTime  @default(now())

  @@index([safetyAction, createdAt])
  @@index([confidenceLevel, createdAt])
}

model AIEvaluation {
  id                String    @id @default(cuid())
  interactionId     String    @unique
  accuracy          Float
  pedagogy          Float
  safety            Float
  completeness      Float
  overall           Float
  reasoning         String?   @db.Text
  suggestions       String?   @db.Text
  humanReviewed     Boolean   @default(false)
  humanAccuracy     Float?
  humanPedagogy     Float?
  humanSafety       Float?
  humanCompleteness Float?
  humanOverall      Float?
  humanNotes        String?   @db.Text
  reviewedBy        String?
  reviewedAt        DateTime?
  promptVariant     String?   // A/B test variant
  createdAt         DateTime  @default(now())

  interaction       AIInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([overall, createdAt])
  @@index([promptVariant, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String?
  action      String
  targetType  String
  targetId    String
  details     String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ─── Self Learning (open-topic AI-generated lessons) ───

model LearningPath {
  id              String    @id @default(cuid())
  userId          String
  topic           String
  title           String
  description     String?
  estimatedHours  Float?
  lessons         Json      // Array of lesson outlines
  currentLesson   Int       @default(1)
  status          String    @default("in_progress") // in_progress, completed, abandoned
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@index([userId, status])
}

model LessonProgress {
  id            String    @id @default(cuid())
  pathId        String
  lessonNumber  Int
  userId        String
  content       Json?     // The generated lesson content (sections array)
  quizScore     Float?    // 0.0 - 1.0
  quizAnswers   Json?     // Student's selected answers
  completed     Boolean   @default(false)
  timeSpentSec  Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  path          LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, lessonNumber])
  @@index([userId, completed])
}

// ─── Live Session Experience ───

model SessionSummary {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  content     String   @db.Text         // Markdown summary
  contentDari String?  @db.Text
  quizData    String?  @db.Text         // JSON quiz generated from the summary
  generatedAt DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionNote {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model HomeworkAssignment {
  id          String    @id @default(cuid())
  sessionId   String
  classId     String
  title       String
  description String    @db.Text
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([classId, dueDate])
}

model HomeworkSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?  @db.Text
  fileUrl      String?
  imageUrl     String?
  aiReview     String?  @db.Text
  teacherGrade String?
  teacherNotes String?  @db.Text
  submittedAt  DateTime @default(now())

  assignment   HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ─── Student Voices (community-generated content) ───

model StudentPost {
  id            String    @id @default(cuid())
  authorId      String

  // Content
  type          String    // article, creative_writing, poetry, art, spotlight
  title         String
  titleDari     String?
  slug          String    @unique // URL-friendly
  content       String?   @db.Text
  contentDari   String?   @db.Text
  excerpt       String?
  excerptDari   String?

  // Media
  coverImageUrl String?
  galleryUrls   String?   @db.Text // JSON array of image URLs

  // Metadata
  language      String    @default("en") // en, da, both
  category      String?
  tags          String?   // Comma-separated
  readTimeMin   Int?

  // Publishing
  status        String    @default("draft") // draft, pending_review, published, rejected, archived
  publishedAt   DateTime?
  featured      Boolean   @default(false)
  anonymous     Boolean   @default(false)

  // Moderation
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?   @db.Text

  // Engagement
  viewCount     Int       @default(0)
  likeCount     Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes         PostLike[]

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([authorId, status])
  @@index([featured, publishedAt])
}

model PostLike {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())

  post      StudentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

// ─── Spaced Repetition (SM-2 algorithm) ───

model SpacedRepetitionItem {
  id             String    @id @default(cuid())
  userId         String
  term           String    // The word or concept
  definition     String    @db.Text
  context        String?   @db.Text // Example sentence or source reference
  classId        String?

  // SM-2 fields
  easeFactor     Float     @default(2.5)   // 1.3 - 4.0
  interval       Int       @default(1)     // Days until next review
  repetitions    Int       @default(0)     // Consecutive correct answers
  nextReviewAt   DateTime  @default(now()) // When to show again
  lastReviewedAt DateTime?

  createdAt      DateTime  @default(now())

  @@index([userId, nextReviewAt])
  @@index([userId, classId])
}

// ─── AI Conversation Memory (foundation for future multi-turn) ───

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sessionId])
}

// ─── Production Hardening (rate limiting, persisted announcements, site settings) ───

// Fixed-window distributed rate limiting. One row per bucket key; the window
// resets by overwriting `resetAt`/`count`. See src/lib/security/rate-limit.ts.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Persisted class announcements (previously an in-memory array that was lost on
// every server restart). See src/lib/platform/db-store.ts.
model ClassAnnouncement {
  id         String   @id @default(cuid())
  classId    String
  authorId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  klass      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
}

// Singleton row holding platform-wide settings as JSON.
model SiteSettings {
  id           String   @id
  instagramUrl String?
  facebookUrl  String?
  twitterUrl   String?
  linkedinUrl  String?
  youtubeUrl   String?
  telegramUrl  String?
  contactEmail String?
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

// ─── Background job queue (automation backbone) ──────────────────────────────
//
// A durable, Postgres-backed work queue. Workers claim due jobs with
// FOR UPDATE SKIP LOCKED (see src/lib/jobs/queue.ts), so many workers can drain
// concurrently without double-processing. Failed jobs retry with exponential
// backoff and dead-letter (status=DEAD) after maxAttempts. `dedupeKey` gives
// idempotency (enqueueing the same logical job twice is a no-op).

enum JobStatus {
  PENDING // waiting to run (runAt in the past = due)
  ACTIVE // claimed by a worker, in progress
  COMPLETED
  FAILED // will retry (attempts < maxAttempts)
  DEAD // exhausted retries; needs human attention
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  priority    Int       @default(0) // higher runs first among due jobs
  runAt       DateTime  @default(now()) // earliest time the job may run
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  dedupeKey   String?   @unique // idempotency: skip if a live job already has it
  lockedAt    DateTime?
  lockedBy    String? // worker id holding the claim
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Claim query orders due work by (priority desc, runAt asc) filtered on status.
  @@index([status, runAt, priority])
  @@index([type, status])
}


/// Single-use, time-limited password-reset tokens. We store only the SHA-256
/// hash of the token (never the raw value); the raw token is emailed as a link.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
