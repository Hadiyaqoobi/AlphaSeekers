# Database
DATABASE_URL="postgresql://user:password@localhost:5432/alphaseekers"

# App mode
# - demo: enables demo auth, auto-seeding, mock Meet links, and DB→memory fallback (good for local development)
# - production: disables the above patches so the DB + integrations are the system of truth
ALPHASEEKERS_MODE="demo"
# Optional toggles (override defaults based on ALPHASEEKERS_MODE)
# ALPHASEEKERS_ALLOW_DEMO_AUTH="true"
# ALPHASEEKERS_AUTO_SEED="true"
# ALPHASEEKERS_ALLOW_MOCK_MEET_LINKS="true"
# ALPHASEEKERS_ALLOW_DB_FALLBACK="true"
#
# Landing stats: "static" (marketing copy) or "dynamic" (safe bucketed counts)
ALPHASEEKERS_PUBLIC_STATS="static"

# NextAuth
NEXTAUTH_URL="http://localhost:3005"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-cron-secret"

# Future integrations (Phase 3+)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3005/api/integrations/google/callback"
GOOGLE_API_KEY=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION="v19.0"
# Gmail SMTP (enable 2FA, then generate App Password at myaccount.google.com)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AlphaSeekers <your-gmail@gmail.com>"
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""

# AI Study Assistant (RAG)
# Both providers offer free tiers with no credit card required.
GROQ_API_KEY=""           # Get from console.groq.com (free: 14,400 req/day)
GEMMA_API_KEY=""          # Get from aistudio.google.com/apikey (free fallback)
HF_API_TOKEN=""           # Get from huggingface.co/settings/tokens (free)
# Optional overrides:
# GROQ_MODEL="llama-3.1-8b-instant"
# HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# RAG_CHUNK_SIZE="1500"
# RAG_CHUNK_OVERLAP="200"
# RAG_TOP_K="5"
# RAG_SIMILARITY_THRESHOLD="0.3"
