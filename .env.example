# Database
# In PRODUCTION this MUST be the Neon POOLED connection string — the host contains
# "-pooler" (e.g. ...@ep-xyz-pooler.us-east-2.aws.neon.tech/db?sslmode=require).
# The direct (non-pooled) endpoint exhausts Neon's connection cap under serverless load.
DATABASE_URL="postgresql://user:password@localhost:5432/alphaseekers"

# Neon DIRECT (unpooled) connection string — the same as DATABASE_URL but with
# `-pooler` REMOVED from the hostname. Used only to run migrations:
# `prisma migrate deploy` cannot hold its advisory lock through PgBouncer, so a
# migration over the pooled URL hangs or strands the lock. The app never reads
# this. Required on Render (preDeployCommand); optional locally unless you are
# applying migrations.
DIRECT_DATABASE_URL=
# Optional: per-instance Prisma connection cap. Appended as ?connection_limit=<n>
# to DATABASE_URL if not already present (recommended small value with PgBouncer/pooler).
# The same thing can be written straight into the URL instead:
#   postgresql://...-pooler.../db?sslmode=require&connection_limit=5
# It caps the pool of ONE Prisma client. The app keeps exactly one client per
# process (on globalThis, production included; src/lib/prisma.ts), so with the
# single Render instance this is the cap for the whole service. Without either
# setting Prisma picks num_cpus * 2 + 1. Neon's pooler accepts far more than 5,
# so this is about not hogging the pool, not about a hard limit.
# DATABASE_CONNECTION_LIMIT="5"

# App mode
# - demo: enables demo auth, auto-seeding, mock Meet links, and DB→memory fallback (good for local development)
# - production: disables the above patches so the DB + integrations are the system of truth
# When UNSET, the mode is derived from NODE_ENV: a production build defaults to
# "production" (all insecure toggles OFF); anything else defaults to "demo".
ALPHASEEKERS_MODE="demo"
# Optional toggles (override defaults based on ALPHASEEKERS_MODE)
# ALPHASEEKERS_ALLOW_DEMO_AUTH="true"
# ALPHASEEKERS_AUTO_SEED="true"
# ALPHASEEKERS_ALLOW_MOCK_MEET_LINKS="true"
# ALPHASEEKERS_ALLOW_DB_FALLBACK="true"
# Escape hatch: set to "true" to allow a production build (NODE_ENV=production) to
# boot WITH insecure demo toggles on. Without it, the app fails fast at boot. Never
# set this on a real production deployment.
# ALPHASEEKERS_I_KNOW_THIS_IS_DEMO="true"
#
# Landing stats: "static" (marketing copy) or "dynamic" (safe bucketed counts)
ALPHASEEKERS_PUBLIC_STATS="static"

# NextAuth
NEXTAUTH_URL="http://localhost:3005"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-cron-secret"

# At-rest field encryption (AES-256-GCM). Base64-encoded 32-byte key.
# Generate: openssl rand -base64 32
# Required in production; in dev the crypto layer falls back to a "plain:" passthrough.
DATA_ENCRYPTION_KEY=""

# Telegram bot webhook — shared secret returned in the
# X-Telegram-Bot-Api-Secret-Token header; used to authenticate inbound webhooks.
TELEGRAM_WEBHOOK_SECRET=""

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# CORS — comma-separated origins permitted to call public API routes
# (health, posts, classes, library, webinars, opportunities). Leave empty to
# block all cross-origin requests. Use "*" only in dev — it disables
# Access-Control-Allow-Credentials enforcement on the browser side.
CORS_ALLOWED_ORIGINS=""

# Future integrations (Phase 3+)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3005/api/integrations/google/callback"
GOOGLE_API_KEY=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION="v19.0"
# Gmail SMTP (enable 2FA, then generate App Password at myaccount.google.com)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AlphaSeekers <your-gmail@gmail.com>"

# Cloudflare R2 (object storage). Names aligned with the code (Bundle E).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL for serving R2 assets (also drives next.config.mjs image/CSP allowlist),
# e.g. https://pub-xxxx.r2.dev or a custom CDN domain.
R2_PUBLIC_BASE_URL=""

# AI Study Assistant (RAG)
# Both providers offer free tiers with no credit card required.
GROQ_API_KEY=""           # Get from console.groq.com (free: 14,400 req/day)
GEMMA_API_KEY=""          # Get from aistudio.google.com/apikey (free fallback)
# Some AI SDKs read these alias names for the Gemini/Google model instead — set
# whichever the provider client expects.
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""
HF_API_TOKEN=""           # Get from huggingface.co/settings/tokens (free)
# Optional overrides:
# GROQ_MODEL="llama-3.1-8b-instant"
# HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# RAG_CHUNK_SIZE="1500"
# RAG_CHUNK_OVERLAP="200"
# RAG_TOP_K="5"
# RAG_SIMILARITY_THRESHOLD="0.3"

# Public-page cache (src/lib/platform/public-cache.ts)
# How long a cached public page's data is trusted if nothing invalidates or
# refreshes it first. Default 93600 (26h) — longer than a day, because the DAILY
# cron tick is what renews it (ADR-0008). Writes made through the app invalidate
# and re-load at once; rows edited by hand in the Neon console show up within a
# day, or at once after a redeploy. Set to 0 to switch the cache off; every
# signed-out page view then queries (and wakes) the database again.
# PUBLIC_CACHE_TTL_SECONDS="93600"
